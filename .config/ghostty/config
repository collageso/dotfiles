# ==================================================
# Font
# ==================================================

font-family = IosevkaTerm NFM
font-size = 12.5

font-feature = -calt
font-feature = -liga
font-feature = -dlig

# ==================================================
# Window
# ==================================================

window-decoration = none

window-padding-x = 24
window-padding-y = 20
window-padding-balance = true
window-padding-color = background

background-opacity = 1

# ==================================================
# Cursor
# ==================================================

cursor-style = block
cursor-style-blink = false

# Actual typing cursor.
cursor-color = #80a8ad
cursor-text = #080809

# Prevent shell integration from changing the cursor.
shell-integration-features = no-cursor

# ==================================================
# Colors
# ==================================================

foreground = #bac5cf
background = #0b0b0c

selection-foreground = #bac5cf
selection-background = #1b1d20

# ==================================================
# ANSI colors
# ==================================================

# Normal
palette = 0=#080809
palette = 1=#a9737c
palette = 2=#819b91
palette = 3=#a99f7d
palette = 4=#7898b0
palette = 5=#918daa
palette = 6=#80a8ad
palette = 7=#bac5cf

# Bright
palette = 8=#404c57
palette = 9=#b98189
palette = 10=#93ada2
palette = 11=#bbb087
palette = 12=#8baabd
palette = 13=#a29dbb
palette = 14=#93b9bd
palette = 15=#d4dde4

# Extended theme colors
palette = 16=#a88f7c
palette = 17=#292c30
palette = 18=#0f1012
palette = 19=#1b1d20
palette = 20=#697783
palette = 21=#9ca9b4
palette = 22=#111214
palette = 23=#151b17
palette = 24=#15191e
palette = 25=#1c1417

# ==================================================
# Mouse
# ==================================================

copy-on-select = true

mouse-hide-while-typing = false
mouse-scroll-multiplier = 3

# ==================================================
# Scrollback
# ==================================================

scrollback-limit = 10485760

# ==================================================
# Keybindings
# ==================================================

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = ctrl+shift+n=new_window

keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# ==================================================
# Behavior
# ==================================================

confirm-close-surface = false
