{
    "layer": "top",
    "position": "bottom",
    "height": 22, 
    "spacing": 0, 
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
        "pulseaudio", 
        "custom/sep",
        "network", 
        "custom/sep",
        "cpu", 
        "custom/sep",
        "memory", 
        "custom/sep",
        "battery", 
        "custom/sep",
        "clock"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "custom/sep": {
        "format": "|",
        "color": "#666666"
    },

    "clock": {
        "format": "{:%Y-%m-%d %I:%M %p}"
    },

    "cpu": { "format": "CPU: {usage}%" },
    "memory": { "format": "RAM: {percentage}%" },
    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTE"
    },
    "network": {
        "format-wifi": "WIFI: {essid}",
        "format-ethernet": "ETH: {ifname}"
    }
}
